# Spectrum Launcher - Bazel root
# 开发: bazel build //:build_all          -> bazel-bin/launcher/
# 发布: bazel build //:build_release      -> bazel-bin/nuitka/main.dist + builds/nuitka-VERSION/

load("@bazel_skylib//rules:build_test.bzl", "build_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "cargo_build.ps1",
    "cargo_build.sh",
    "make_tools.py",
    "tools/assemble_launcher.ps1",
    "tools/assemble_launcher.sh",
    "tools/nuitka_build.ps1",
    "tools/nuitka_build.sh",
    "tools/nuitka_release.ps1",
    "tools/resolve_python.ps1",
    "tools/ensure_build_env.ps1",
])

_LAUNCHER_SRCS = [
    ":launcher_py",
    ":runtime_assets",
    "//spectrum-core:spectrum_core_native",
]

_NUITKA_SRCS = _LAUNCHER_SRCS + ["make_tools.py"]

filegroup(
    name = "runtime_assets",
    srcs = glob(
        [
            "assets/**",
            "languages/**",
            "themes/**",
            "qml/**",
            "web/**",
            "fonts/**/OFL.txt",
            "fonts/**/README.txt",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "launcher_py",
    srcs = glob(
        ["*.py"],
        exclude = ["make_tools.py"],
    ) + ["//app:app_src", "//python:spectrum_core_src"],
)

filegroup(
    name = "launcher",
    srcs = _LAUNCHER_SRCS,
)

filegroup(
    name = "nuitka_inputs",
    srcs = _NUITKA_SRCS,
)

# 组装可运行目录 bazel-bin/launcher/
genrule(
    name = "launcher_pkg",
    srcs = _LAUNCHER_SRCS,
    outs = ["launcher/.complete"],
    cmd = select({
        "@platforms//os:windows": "cmd.exe /C powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(execpath //:tools/assemble_launcher.ps1)\" -OutDir \"$(@D)\" -StampFile \"$(execpath :launcher/.complete)\" -PydPath \"$(execpath //spectrum-core:spectrum_core_native)\"",
        "//conditions:default": "bash \"$(execpath //:tools/assemble_launcher.sh)\" \"$(@D)\" \"$(execpath :launcher/.complete)\" \"$(execpath //spectrum-core:spectrum_core_native)\"",
    }),
    tools = select({
        "@platforms//os:windows": ["//:tools/assemble_launcher.ps1"],
        "//conditions:default": ["//:tools/assemble_launcher.sh"],
    }),
)

# Nuitka standalone -> bazel-bin/nuitka/main.dist/
genrule(
    name = "nuitka_standalone",
    srcs = _NUITKA_SRCS,
    outs = ["nuitka/.complete"],
    cmd = select({
        "@platforms//os:windows": "cmd.exe /C powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$(execpath //:tools/nuitka_build.ps1)\" -OutDir \"$(@D)\" -StampFile \"$(execpath :nuitka/.complete)\" -PydPath \"$(execpath //spectrum-core:spectrum_core_native)\"",
        "//conditions:default": "bash \"$(execpath //:tools/nuitka_build.sh)\"",
    }),
    tools = select({
        "@platforms//os:windows": [
            "//:tools/nuitka_build.ps1",
            "//:tools/resolve_python.ps1",
            "//:tools/ensure_build_env.ps1",
        ],
        "//conditions:default": ["//:tools/nuitka_build.sh"],
    }),
)

alias(
    name = "spectrum_core",
    actual = "//python:spectrum_core",
)

build_test(
    name = "build_all",
    targets = [
        "//spectrum-core:spectrum_core_native",
        "//python:spectrum_core",
        ":launcher_pkg",
    ],
)

build_test(
    name = "build_release",
    targets = [
        "//spectrum-core:spectrum_core_native",
        "//python:spectrum_core",
        ":launcher_pkg",
        ":nuitka_standalone",
    ],
)
