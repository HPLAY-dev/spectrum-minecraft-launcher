/* Spectrum — 全局 QSS（对话框 / 旧版 Widget）色卡 #777C6D #B7B89F #CBCBCB #EEEEEE */

* {
    font-family: "Source Han Serif CN", "Noto Serif SC", SimSun, serif;
    font-weight: 400;
}

QMessageBox, QDialog, QFileDialog {
    background-color: #EEEEEE;
    color: #777C6D;
}

QLabel {
    font-family: "Source Han Serif CN", "Noto Serif SC", SimSun, serif;
    font-weight: 400;
    color: #777C6D;
}

QPushButton {
    background-color: #EEEEEE;
    color: #777C6D;
    border: 1px solid #CBCBCB;
    padding: 8px 16px;
    min-height: 28px;
    font-family: "Source Han Serif CN", "Noto Serif SC", SimSun, serif;
}

QPushButton:hover {
    background-color: #CBCBCB;
}

QPushButton:pressed {
    background-color: #B7B89F;
}

QLineEdit, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #EEEEEE;
    color: #777C6D;
    border: 1px solid #CBCBCB;
    padding: 6px 10px;
    selection-background-color: #B7B89F;
    selection-color: #777C6D;
    font-family: "Source Han Serif CN", "Noto Serif SC", SimSun, serif;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QProgressBar {
    background-color: #EEEEEE;
    border: 1px solid #CBCBCB;
    text-align: center;
    color: #777C6D;
    height: 18px;
}

QProgressBar::chunk {
    background-color: #777C6D;
}

QScrollBar:vertical {
    background: #EEEEEE;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #CBCBCB;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QListView, QTreeView, QTableView {
    background-color: #EEEEEE;
    color: #777C6D;
    border: 1px solid #CBCBCB;
    outline: none;
    font-family: "Source Han Serif CN", "Noto Serif SC", SimSun, serif;
}

QListView::item:selected, QTreeView::item:selected {
    background-color: #777C6D;
    color: #EEEEEE;
}

QTabWidget::tab-bar {
    font-family: "Source Han Serif CN", "Noto Serif SC", SimSun, serif;
    font-weight: 600;
}

QTabBar::tab {
    font-family: "Source Han Serif CN", "Noto Serif SC", SimSun, serif;
    font-weight: 600;
    color: #777C6D;
}

QTabBar::tab:selected {
    background: #777C6D;
    color: #EEEEEE;
}
