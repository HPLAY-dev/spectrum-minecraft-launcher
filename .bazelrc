build --enable_platform_specific_config
build --check_direct_dependencies=off

# PyO3 / Cargo 构建需要宿主 Python 与 Rust 工具链
build --action_env=PYO3_PYTHON
build --action_env=USERPROFILE
build --action_env=CARGO_HOME
build --action_env=RUSTUP_HOME
build --action_env=LAUNCHER_VERSION

# Nuitka / Scons / MSVC need Windows env (Bazel sandbox strips these by default)
build --action_env=PROCESSOR_ARCHITECTURE
build --action_env=PROCESSOR_ARCHITEW6432
build --action_env=SystemRoot
build --action_env=ComSpec
build --action_env=TEMP
build --action_env=TMP
build --action_env=OS
build --action_env=ProgramFiles
build --action_env=ProgramFiles(x86)
build --action_env=ProgramW6432
build --action_env=Path
